# Настройки сборки прилдожения
APP_SRC="./app-template"          # app souce dir
APP_BUILD="./app-template/build"  # app target dir
APP_CANVAS=150                    # размер стороы экрана (canvas)
APP_FPS=45                        # 30, 45, 60...

# Флаги компиляции
WARCH=wasm32 # какой wasm использовать: wasm32 или wasm64 
DFLAGS=      # кастомные фиче-флаги приложения: DFLAGS="-DWITH_CHEATS"
CFLAGS="$CFLAGS"

# Версии утилит:
CLANG=clang-20   # clang version >=20
WLDD=wasm-ld-20  # lld version >=20

# Тонкие настройки
FW_BUILD_CLEANUP=yes  # yes = удалить промежуточные файлы сборки после build.sh
FW_TEST_FRAMEWORK=yes # yes = запускать тесты фреймворка дополнительно к тестам приложения при run_tests.sh